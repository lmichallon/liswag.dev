---
import { tv } from 'tailwind-variants';
import Grain from '../Grain.astro';

interface Props {
	t: {
		quote: string;
		quote2: string;
	};
}
const { t } = Astro.props;

const styles = tv({
	slots: {
		section: "mt-1.6 mx-1.6 mb-1.6 md:mt-2.4 md:mx-2.4 md:mb-2.4",
		card: "sticky top-[4.8rem] h-[65vh] md:h-[calc(100vh-9.6rem)] bg-pimento px-1.6 py-2.4 md:px-2.4 md:py-4.8 rounded-md overflow-hidden",
		quotes: "relative z-10",
		quoteInitial: "text-sm md:text-lg whitespace-pre-line leading-2.4 md:leading-4.2 font-normal block transition-[opacity,transform] duration-500 ease-in-out will-change-[opacity,transform]",
		quoteReveal: "text-sm md:text-lg whitespace-pre-line leading-2.4 md:leading-4.2 font-normal block absolute top-0 opacity-0 translate-y-[2rem] transition-[opacity,transform] duration-500 ease-in-out will-change-[opacity,transform]",
	},
});

const { section, card, quotes, quoteInitial, quoteReveal } = styles();
---

<div id="qualities" class={`${section()} h-[calc(140vh-4.8rem)]`}>
	<section class={card()}>
		<Grain />
		<div class={quotes()}>
			<strong id="quote-initial" class={quoteInitial()}>
				{t.quote}
			</strong>
			<strong id="quote-reveal" class={quoteReveal()}>
				{t.quote2}
			</strong>
		</div>
	</section>
</div>

<script>
	function getEl(id: string): HTMLElement {
		const el = document.getElementById(id);
		if (!(el instanceof HTMLElement)) throw new Error(`#${id} not found`);
		return el;
	}

	function init() {
		const qualities = getEl('qualities');
		const quotes = [getEl('quote-initial'), getEl('quote-reveal')];

		function update() {
			const rect = qualities.getBoundingClientRect();
			const scrollable = rect.height - window.innerHeight;
			const progress = scrollable > 0 ? Math.max(0, Math.min(1, -rect.top / scrollable)) : 0;
			const swapped = progress > 0.5;

			quotes[0].style.opacity = swapped ? '0' : '1';
			quotes[0].style.transform = swapped ? 'translateY(-2rem)' : 'translateY(0)';

			quotes[1].style.opacity = swapped ? '1' : '0';
			quotes[1].style.transform = swapped ? 'translateY(0)' : 'translateY(2rem)';
		}

		window.addEventListener('scroll', update, { passive: true });
		update();
	}

	document.addEventListener('astro:page-load', () => {
		try { init(); } catch { /* elements not found */ }
	});
</script>
