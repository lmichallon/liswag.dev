---
import { tv } from 'tailwind-variants';

interface Props {
	baseFrequency?: number;
	opacity?: number;
}

const { baseFrequency = 1.25, opacity = 0.25 } = Astro.props;

const styles = tv({
	slots: {
		grain: "absolute inset-0 w-full h-full pointer-events-none mix-blend-multiply",
	},
});

const { grain } = styles();
---

<svg class={grain()} width="100%" height="100%" aria-hidden="true">
    <filter id="grain">
        <feTurbulence type="fractalNoise" baseFrequency={baseFrequency} numOctaves="2" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
            <feFuncR type="discrete" tableValues="0 1" />
            <feFuncG type="discrete" tableValues="0 1" />
            <feFuncB type="discrete" tableValues="0 1" />
        </feComponentTransfer>
    </filter>
    <rect width="100%" height="100%" filter="url(#grain)" opacity={opacity} />
</svg>
