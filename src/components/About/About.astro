---
import { tv } from 'tailwind-variants';

interface Props {
	t: {
		title: string;
		body: string;
	};
}
const { t } = Astro.props;

const styles = tv({
	slots: {
		section: "grid-display px-1.6 md:px-2.4 pt-4.8 pb-[4.8rem] md:pb-[14.8rem] cursor-default",
		title: "text-sm md:text-md col-span-6",
		body: "text-xs md:text-sm col-span-6 whitespace-pre-line",
		cursorImage: "pointer-events-none fixed top-0 left-0 w-[22rem] opacity-0 transition-opacity duration-300 z-50 select-none will-change-transform",
	},
});

const { section, title, body, cursorImage } = styles();
---

<section id="about-section" class={section()}>
    <h2 class={title()}>{t.title}</h2>
    <p class={body()}>{t.body}</p>
</section>

<img
    id="about-cursor-img"
    src="/prout.jpg"
    alt=""
    class={cursorImage()}
    aria-hidden="true"
/>

<script>
    const section = document.getElementById('about-section');
    const img = document.getElementById('about-cursor-img') as HTMLImageElement;

    let mouseX = 0;
    let mouseY = 0;
    let currentX = 0;
    let currentY = 0;
    let isInSection = false;
    let animating = false;

    const SMOOTHING_FACTOR = 0.12;

    function interpolate(a: number, b: number, t: number) {
        return a + (b - a) * t;
    }

    function animate() {
        if (!isInSection) { animating = false; return; }
        animating = true;

        currentX = interpolate(currentX, mouseX, SMOOTHING_FACTOR);
        currentY = interpolate(currentY, mouseY, SMOOTHING_FACTOR);

        img.style.transform = `translate(${(currentX + 18) / 10}rem, ${(currentY + 18) / 10}rem)`;
        requestAnimationFrame(animate);
    }

    section?.addEventListener('mouseenter', () => {
        isInSection = true;
        img.style.opacity = '1';
        if (!animating) animate();
    });

    section?.addEventListener('mouseleave', () => {
        isInSection = false;
        img.style.opacity = '0';
    });

    section?.addEventListener('mousemove', (e: MouseEvent) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
    });
</script>
