---
import Grain from '../Grain.astro';

interface Props {
	t: {
		quote: string;
		quote2: string;
	};
}
const { t } = Astro.props;
---

<div id="qualities" class="mt-2.4 mx-2.4 mb-2.4" style="height: calc(140vh - 4.8rem)">
	<section class="sticky top-[4.8rem] h-[calc(100vh-9.6rem)] bg-pimento px-2.4 py-4.8 rounded-md relative overflow-hidden">
		<Grain />
		<div class="relative z-10">
			<strong id="quote-initial" class="text-lg whitespace-pre-line leading-4.2 font-normal block" style="transition: opacity 0.5s cubic-bezier(0.4,0,0.2,1), transform 0.5s cubic-bezier(0.4,0,0.2,1); will-change: opacity, transform;">
				{t.quote}
			</strong>
			<strong id="quote-transition" class="text-lg whitespace-pre-line leading-4.2 font-normal block absolute top-0" style="opacity: 0; transform: translateY(20px); transition: opacity 0.5s cubic-bezier(0.4,0,0.2,1), transform 0.5s cubic-bezier(0.4,0,0.2,1); will-change: opacity, transform;">
				{t.quote2}
			</strong>
		</div>
	</section>
</div>

<script>
	function getEl(id: string): HTMLElement {
		const el = document.getElementById(id);
		if (!(el instanceof HTMLElement)) throw new Error(`#${id} not found`);
		return el;
	}

	function init() {
		const qualities = getEl('qualities');
		const quotes = [getEl('quote-initial'), getEl('quote-transition')];

		function update() {
			const rect = qualities.getBoundingClientRect();
			const scrollable = rect.height - window.innerHeight;
			const progress = scrollable > 0 ? Math.max(0, Math.min(1, -rect.top / scrollable)) : 0;
			const swapped = progress > 0.5;

			quotes[0].style.opacity = swapped ? '0' : '1';
			quotes[0].style.transform = swapped ? 'translateY(-20px)' : 'translateY(0)';

			quotes[1].style.opacity = swapped ? '1' : '0';
			quotes[1].style.transform = swapped ? 'translateY(0)' : 'translateY(20px)';
		}

		window.addEventListener('scroll', update, { passive: true });
		update();
	}

	document.addEventListener('astro:page-load', () => {
		try { init(); } catch { /* elements not found */ }
	});
</script>
